# Generate a private .env: python3 -m server.manage init-env
# Replace the placeholder with a random token of at least 32 characters.
ADMIN_TOKEN=
# Local preview: leave empty. Production: exact public origin, without slash.
PUBLIC_ORIGIN=
REGISTER_URL=https://app.teacherdesk.ru/register
LOGIN_URL=https://app.teacherdesk.ru/login
# Enable only behind a trusted proxy that replaces X-Forwarded-For.
TRUST_PROXY=false
RATE_LIMIT=5
RATE_WINDOW=600
# Native run defaults to server/data. Docker overrides this with /data.
DATA_DIR=server/data
